+static void battery_overlay_end(struct k_work *work) {
+    battery_overlay_active = false;
+    if (state.on) {
+        /* The normal 50 ms tick restores the configured color and effect. */
+        return;
+    }
+
+    k_timer_stop(&underglow_tick);
+    memset(pixels, 0, sizeof(pixels));
+    led_strip_update_rgb(led_strip, pixels, STRIP_NUM_PIXELS);
+#if IS_ENABLED(CONFIG_ZMK_RGB_UNDERGLOW_EXT_POWER)
+    if (!battery_overlay_power_was_on) {
+        ext_power_disable(ext_power);
+    }
+#endif
+}
+
+K_WORK_DELAYABLE_DEFINE(battery_overlay_end_work, battery_overlay_end);
+
+static void battery_overlay_start(struct k_work *work) {
+    if (!state.on && !battery_overlay_active) {
+#if IS_ENABLED(CONFIG_ZMK_RGB_UNDERGLOW_EXT_POWER)
+        int power = ext_power_get(ext_power);
+        if (power < 0) {
+            return;
+        }
+        battery_overlay_power_was_on = power != 0;
+        if (!battery_overlay_power_was_on && ext_power_enable(ext_power) < 0) {
+            return;
+        }
+#endif
+    }
+
+    battery_overlay_percent = battery_overlay_requested_percent;
+    battery_overlay_active = true;
+    k_timer_start(&underglow_tick, K_NO_WAIT, K_MSEC(50));
+    k_work_reschedule_for_queue(zmk_workqueue_lowprio_work_q(), &battery_overlay_end_work,
+                                K_MSEC(BATTERY_LED_DURATION_MS));
+}
+
+K_WORK_DEFINE(battery_overlay_start_work, battery_overlay_start);
+
+int zmk_rgb_underglow_show_battery(uint8_t percent) {
+    if (!led_strip) {
+        return -ENODEV;
+    }
+
+    battery_overlay_requested_percent = MIN(percent, 100);
+    int err = k_work_submit_to_queue(zmk_workqueue_lowprio_work_q(), &battery_overlay_start_work);
+    return MIN(err, 0);
+}
