#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>
#include "keys_de.h"

/ {
    chosen { zmk,matrix-transform = &imprint_number_row_full_bottom_row; };

    macros {
        // German ^ and ` are dead keys. Space commits the literal symbol.
        literal_caret: literal_caret {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DE_CARET &kp SPACE>;
        };

        literal_grave: literal_grave {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DE_GRAVE &kp SPACE>;
        };

        switch_to_neo: switch_to_neo {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 1 &rgb_ug RGB_COLOR_HSB(229,94,50)>;
            label = "SWITCH_TO_NEO";
        };

        switch_to_de: switch_to_de {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &rgb_ug RGB_COLOR_HSB(102,51,47)>;
            label = "SWITCH_TO_DE";
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        // Only these two navigation bindings depend on the host layout.
        navigation_de {
            if-layers = <1 3>;
            then-layer = <7>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // 0: physical QWERTZ codes for the Linux Neo host (also plain QWERTZ).
        Qwertz {
            bindings = <
&kp EQUAL            &kp DE_N1         &kp DE_N2  &kp DE_N3  &kp DE_N4      &kp DE_N5                   &kp DE_N6          &kp DE_N7    &kp DE_N8            &kp DE_N9             &kp DE_N0        &switch_to_neo
&kp TAB              &kp DE_Q          &kp DE_W   &kp DE_E   &kp DE_R       &kp DE_T                    &kp DE_Z           &kp DE_U     &kp DE_I             &kp DE_O              &kp DE_P         &kp DE_U_UMLAUT
&mt CAPSLOCK ESCAPE  &kp DE_A          &kp DE_S   &kp DE_D   &kp DE_F       &kp DE_G                    &kp DE_H           &kp DE_J     &kp DE_K             &kp DE_L              &kp DE_O_UMLAUT  &kp DE_A_UMLAUT
&kp LEFT_SHIFT       &lt 3 DE_Y        &kp DE_X   &kp DE_C   &kp DE_V       &kp DE_B                    &kp DE_N           &kp DE_M     &kp DE_COMMA         &kp DE_DOT            &lt 3 DE_MINUS   &kp RSHFT
&mo 4                &kp LEFT_CONTROL  &kp LGUI   &kp LALT   &mo 8                                                         &mo 8        &kp DE_LEFT_BRACKET  &kp DE_RIGHT_BRACKET  &trans           &mo 4
                                                             &kp BACKSPACE  &kp DE_SPACE  &kp ESC       &kp LC(RIGHT_ALT)  &lt 3 ENTER  &kp SPACE
                                                             &kp LCTRL      &kp LEFT_GUI  &kp DELETE    &kp PRINTSCREEN    &kp RALT     &kp RCTRL
            >;
        };

        // 1: Neo emulation for a host with German QWERTZ selected.
        NEO_Layout {
            bindings = <
&trans     &trans             &trans           &trans           &trans    &trans              &trans    &trans          &trans        &trans      &trans      &switch_to_de
&trans     &kp DE_X           &kp DE_V         &kp DE_L         &kp DE_C  &kp DE_W            &kp DE_K  &kp DE_H        &kp DE_G      &kp DE_F    &kp DE_Q    &kp DE_SHARP_S
&lt 2 ESC  &kp DE_U           &kp DE_I         &kp DE_A         &kp DE_E  &kp DE_O            &kp DE_S  &kp DE_N        &kp DE_R      &kp DE_T    &kp DE_D    &kp DE_Y
&trans     &lt 3 DE_U_UMLAUT  &kp DE_O_UMLAUT  &kp DE_A_UMLAUT  &kp DE_P  &kp DE_Z            &kp DE_B  &kp DE_M        &kp DE_COMMA  &kp DE_DOT  &lt 3 DE_J  &trans
&trans     &trans             &trans           &trans           &trans                                  &trans          &trans        &trans      &trans      &trans
                                                                &trans    &trans    &trans    &trans    &trans          &trans
                                                                &trans    &trans    &trans    &trans    &lt 2 DE_CARET  &trans
            >;
        };

        Programming {
            bindings = <
&trans  &kp RA(DE_N1)     &kp RA(DE_N2)  &kp RA(DE_N3)        &trans                &trans                     &trans              &trans                   &trans                    &trans               &trans            &trans
&trans  &trans            &kp DE_UNDER   &kp DE_LEFT_BRACKET  &kp DE_RIGHT_BRACKET  &literal_caret             &kp DE_EXCLAMATION  &kp DE_LESS_THAN         &kp DE_GREATER_THAN       &kp DE_EQUAL         &kp DE_AMPS       &trans
&trans  &kp DE_BACKSLASH  &kp DE_SLASH   &kp DE_LEFT_BRACE    &kp DE_RIGHT_BRACE    &kp DE_ASTERISK            &kp DE_QUESTION     &kp DE_LEFT_PARENTHESIS  &kp DE_RIGHT_PARENTHESIS  &kp DE_MINUS         &kp DE_COLON      &kp DE_AT_SIGN
&trans  &kp DE_HASH       &kp DE_DOLLAR  &kp DE_PIPE          &kp DE_TILDE          &literal_grave             &kp DE_PLUS         &kp DE_PERCENT           &kp DE_DOUBLE_QUOTES      &kp DE_SINGLE_QUOTE  &kp DE_SEMICOLON  &trans
&trans  &trans            &trans         &trans               &trans                                                               &trans                   &trans                    &trans               &trans            &trans
                                                              &trans                &trans           &trans    &trans              &trans                   &trans
                                                              &trans                &trans           &trans    &trans              &trans                   &trans
            >;
        };

        // 3: real navigation keys; top-row digits work with NumLock on or off.
        // The two host-dependent keys are overridden by layer 7 for QWERTZ hosts.
        Navigation_Layer {
            bindings = <
&kp ESC           &kp F1       &kp F2         &kp F3      &kp F4      &kp F5                   &kp F6        &kp F7           &kp F8           &kp F9           &kp F10      &kp F11
&trans            &kp PAGE_UP  &kp BACKSPACE  &kp UP      &kp DEL     &kp PAGE_DOWN            &kp KP_EQUAL  &kp N7           &kp N8           &kp N9           &kp KP_PLUS  &trans
&kp LEFT_CONTROL  &kp HOME     &kp LEFT       &kp DOWN    &kp RIGHT   &kp END                  &trans        &kp N4           &kp N5           &kp N6           &trans       &trans
&trans            &trans       &kp TAB        &kp INSERT  &kp ENTER   &kp LC(B)                &trans        &kp N1           &kp N2           &kp N3           &trans       &trans
&trans            &trans       &trans         &kp N0      &trans                                             &trans           &kp N0           &none            &trans       &trans
                                                          &trans      &trans         &trans    &trans        &trans           &kp N0
                                                          &kp INSERT  &trans         &trans    &trans        &trans           &trans
            >;
        };

        Keyboard_Control_Layer {
            bindings = <
&bt BT_CLR   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4              &trans          &rgb_ug RGB_TOG  &rgb_ug RGB_EFF  &trans           &trans           &trans
&sys_reset   &trans        &trans        &trans        &trans        &studio_unlock            &studio_unlock  &rgb_ug RGB_HUI  &rgb_ug RGB_SAI  &rgb_ug RGB_BRI  &rgb_ug RGB_SPI  &sys_reset
&bootloader  &trans        &trans        &trans        &trans        &trans                    &trans          &rgb_ug RGB_HUD  &rgb_ug RGB_SAD  &rgb_ug RGB_BRD  &rgb_ug RGB_SPD  &bootloader
&to 6        &trans        &trans        &trans        &trans        &trans                    &trans          &trans           &trans           &trans           &trans           &to 6
&trans       &trans        &trans        &trans        &trans                                                  &trans           &trans           &trans           &trans           &to 6
                                                       &trans        &trans          &trans    &trans          &trans           &trans
                                                       &trans        &trans          &trans    &trans          &trans           &trans
            >;
        };

        Auto_Mouse_Layer {
            bindings = <
&trans  &trans  &trans     &trans     &trans     &trans            &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans     &trans     &trans     &trans            &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &mkp RCLK  &mkp MCLK  &mkp LCLK  &trans            &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans     &trans     &trans     &trans            &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans     &trans     &trans                               &trans  &trans  &trans  &trans  &trans
                                      &trans     &trans  &trans    &trans  &trans  &trans
                                      &trans     &trans  &trans    &trans  &trans  &trans
            >;
        };

        factory_test {
            bindings = <
&kp N2  &kp N3  &kp N4  &kp N5  &kp N6  &kp N7            &kp N8  &kp N9  &kp N0  &kp N1  &kp N2  &switch_to_de
&kp N4  &kp N5  &kp N6  &kp N7  &kp N8  &kp N9            &kp N0  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5
&kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &kp N1            &kp N2  &kp N3  &kp N4  &kp N5  &kp N6  &kp N7
&kp N8  &kp N9  &kp N0  &kp N1  &kp N2  &kp N3            &kp N4  &kp N5  &kp N6  &kp N7  &kp N8  &kp N9
&kp N0  &kp N1  &kp N2  &kp N3  &kp N4                            &kp N6  &kp N7  &kp N8  &kp N9  &kp N0
                                &kp N1  &kp N2  &kp N3    &kp N4  &kp N5  &kp N6
                                &kp N7  &kp N8  &kp N9    &kp N0  &kp N1  &kp N2
            >;
        };

        // 7: active only with NEO_Layout + Navigation_Layer. KP_EQUAL is not
        // supported on Windows, and Ctrl+Z needs the German Z keycode there.
        Navigation_DE_Host {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans          &trans        &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans          &kp DE_EQUAL  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans          &trans        &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &kp LC(DE_Z)    &trans        &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                               &trans  &trans  &trans  &trans  &trans
                              &trans  &trans  &trans    &trans  &trans  &trans
                              &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };

        // 8: a separate held layer keeps clicks available even when the
        // automatic mouse layer's inactivity timer expires during a drag.
        Manual_Mouse_Layer {
            bindings = <
&trans  &trans  &trans     &trans     &trans     &trans            &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans     &trans     &trans     &trans            &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &mkp RCLK  &mkp MCLK  &mkp LCLK  &trans            &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans     &trans     &trans     &trans            &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans     &trans     &trans                               &trans  &trans  &trans  &trans  &trans
                                      &trans     &trans  &trans    &trans  &trans  &trans
                                      &trans     &trans  &trans    &trans  &trans  &trans
            >;
        };
    };
};

// Right trackball moves the cursor and enables the existing mouse buttons.
&trackball_peripheral_listener {
    input-processors = <&zip_temp_layer 5 1000>;
};

&zip_temp_layer {
    // Avoid activating mouse clicks while typing. Other keys leave mouse mode.
    require-prior-idle-ms = <200>;
    excluded-positions = <26 27 28 52 53>;
};

// Left trackball scrolls; preserve the established sensitivity and direction.
&trackball_central_listener {
    input-processors =
        // multiply sensitivity by 1, divide by 3 (make it slower for scrolling)
        <&zip_xy_scaler 1 3>,
        // make this trackball output scrolling events by default instead of cursor movement
        <&zip_xy_to_scroll_mapper>,
        // invert vertical scrolling so that the view moves with the top of the trackball
        <&zip_scroll_transform INPUT_TRANSFORM_Y_INVERT>;
};
